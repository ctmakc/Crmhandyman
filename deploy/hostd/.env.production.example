# HandymanPro CRM on hostd.Canada — copy to `.env` NEXT TO docker-compose.prod.yml
# (/opt/handyman-crm/deploy/hostd/.env on the box) and fill in. chmod 600 .env.
#
# Compose reads this file automatically because the project directory is deploy/hostd.
# The repo-root .env.example documents every knob in depth; this file pins the values
# that are specific to this box: Cloudflare Tunnel in front, aaPanel owning :80/:443,
# app on loopback :3080.

### Required — `docker compose up` stops before starting the container without these ###

# Signing key for sessions. Generate with: openssl rand -base64 32
# Changing it later signs everyone out of every workspace at once.
NEXTAUTH_SECRET=""

# The app's own public origin — sign-in callbacks and the middleware's self-call both
# use it. This is the tunnel hostname, never the VPS address: nothing on this box
# serves the CRM on :443.
NEXTAUTH_URL="https://crm.agintent.com"

# Token from Cloudflare Zero Trust → Networks → Tunnels → (your tunnel) → token.
# It identifies the tunnel; the routing (crm.agintent.com → http://crm:3000, and
# *.crm.agintent.com → http://crm:3000 for workspace subdomains) is configured in the
# same dashboard, so a routing change never touches this file.
# Туннель локально-управляемый: идентичность и маршруты лежат в /opt/handyman-crm/cloudflared
# (config.yml + tunnel-creds.json), токен не нужен.


### This deployment's shape ###

# The host that is the CRM's front door. The slug parser reads the FIRST label of any
# three-label host as a workspace name, and crm.agintent.com is three labels — without
# this the landing page itself would be treated as tenant «crm». Workspaces live one
# level deeper: <slug>.crm.agintent.com.
CRM_HOME_HOST="crm.agintent.com"

# How many proxies stand in front of the app. The throttles read the client address
# from X-Forwarded-For counting from the RIGHT (src/lib/rate-limit.ts): the rightmost
# entry is the one our trusted proxy appended, everything left of it is whatever the
# caller typed.
#
# ONE is correct for this box, and here is the count: the request path is
# client → Cloudflare edge → cloudflared → app. Exactly one of those appends to
# X-Forwarded-For — Cloudflare's edge, which adds the client address it saw on the TLS
# connection. cloudflared relays the headers from the edge without adding a hop of its
# own, and there is no local nginx/Caddy in this path at all (aaPanel's nginx serves
# other sites and never sees this traffic). So the rightmost entry IS the real client.
# Setting 2 would step one position left into client-controlled text and reopen the
# password-guessing hole the counter exists to close.
TRUSTED_PROXY_HOPS="1"

# Host loopback port for the operator: healthwatch.sh and `ssh … curl` hit it.
# 3080 because 3000 on a shared box is always somebody else's dev server eventually.
APP_PORT="3080"


### Access ###

# Public /register stays CLOSED on this domain: an open form on a real host collects
# strangers' workspaces. Workspaces are created by the operator; set to "on" only for
# a deliberate public-trial period.
SELF_SERVE_SIGNUP=""

# Super-admin panel: both values required, empty slug keeps the panel off entirely.
# Fill after the platform workspace exists (DEPLOY.md, «Первый вход»).
SUPER_ADMIN_EMAILS=""
PLATFORM_TENANT_SLUG=""


### Integrations — each one is fail-closed while its keys are empty ###

# Shared with the email worker that forwards HomeStars/Kijiji leads: the webhook
# verifies every delivery against this key and rejects everything while it is empty.
# The SAME value must be configured on the Mailgun route the worker uses — two
# different keys means every real lead is silently rejected as a forgery.
MAILGUN_WEBHOOK_SIGNING_KEY=""

# Outgoing mail (estimates, invoices, reminders). Empty by default: until a real
# mailbox is chosen for this install, the desk reports reminders as unsent — the truth,
# visible in the UI — rather than half-working through someone's personal Gmail.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Meta (Facebook/Instagram Lead Ads) — unconnected until keys appear.
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""

### Google sign-in / sign-up (self-serve with moderation) ###
# OAuth 2.0 Web client from Google Cloud → Credentials. The redirect URI on the client
# must be https://crm.<root>/api/auth/callback/google — the front door, the single host
# Google's flow is allowed to start from. Leave both empty to keep Google off.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# The front door origin, inlined into the client bundle so the "Continue with Google"
# button knows where to send a subdomain visitor. Empty hides the button.
NEXT_PUBLIC_AUTH_ORIGIN="https://crm.agintent.com"
# Session cookie domain: ".<root>" so a login through the front door reaches every
# workspace subdomain. The middleware still refuses a session whose slug != the host, so
# a shared cookie cannot cross workspaces. Empty → host-only cookie (Google login breaks
# across subdomains). New Google workspaces open PENDING — approve with
# scripts/approve-tenant.ts --slug <workspace>.
NEXTAUTH_COOKIE_DOMAIN=".agintent.com"


### Оповещения — операционные алерты в Telegram (опционально) ###

# healthwatch.sh и backup-cron.sh пишут в локальный лог, который никто не читает.
# Заполни обе строки — и провал (CRM не поднялась после рестарта, ночной бэкап
# упал, копия наружу не легла) прилетит в Telegram одним коротким сообщением.
# Обе пустые → скрипты работают по-старому, только в лог. Как получить значения —
# раздел «Оповещения» в README.md. Молчат при успехе, шлют только при провале.
ALERT_TELEGRAM_BOT_TOKEN=""
ALERT_TELEGRAM_CHAT_ID=""
# Антиспам healthwatch: не чаще одного сообщения раз в столько минут (крон каждые
# 5 мин, лежачая коробка иначе завалит телефон). По умолчанию 60.
ALERT_MIN_INTERVAL_MIN="60"


### Tuning — defaults are fine, listed so the operator sees the whole surface ###

TRIAL_DAYS="7"
LEAD_DEDUP_DAYS="30"
MAX_UPLOAD_MB="12"
MAX_PHOTOS_PER_JOB="40"
# Nightly snapshots kept inside the volume (scripts/backup.sh rotation).
BACKUP_KEEP="14"
# Shown on the trial banner's «Upgrade» button; compiled into the browser bundle, so a
# change here needs `docker compose build`, a restart is not enough.
NEXT_PUBLIC_SUPPORT_EMAIL="support@handymanpro.ca"
