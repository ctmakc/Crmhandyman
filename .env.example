DATABASE_URL="file:./dev.db"

NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"
APP_VERSION="dev"

# Super admin panel access (comma-separated emails)
SUPER_ADMIN_EMAILS="superadmin@yourdomain.com"

# Durable public-ingress rate limits hash identifiers before storage.
# Keep this separate from NEXTAUTH_SECRET so either secret can be rotated independently.
RATE_LIMIT_PEPPER="generate-a-long-random-pepper"

# Signed server-to-server lead intake.
# POST /api/intake/<tenant-slug>/lead with:
# x-handyman-timestamp: Unix time in milliseconds
# x-handyman-signature: sha256=<HMAC_SHA256(timestamp + '.' + raw_body)>
LEAD_INTAKE_SIGNING_SECRET="generate-another-long-random-secret"

# SQLite operational backups
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS="14"

# Private before/after job evidence. Files are never exposed from /public;
# authenticated API routes tenant-scope every read/delete.
EVIDENCE_DIR="./data/evidence"
EVIDENCE_MAX_BYTES="10485760"

# Meta (Facebook + Instagram Lead Ads).
# POST webhooks fail closed (503) when META_APP_SECRET is missing.
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN="choose-any-random-string"

# Google Local Services Ads
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email SMTP (Gmail example)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="yourname@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="HandymanPro <yourname@gmail.com>"

# Mailgun inbound lead parsing. POST webhook fails closed when this key is missing.
MAILGUN_WEBHOOK_SIGNING_KEY=""
