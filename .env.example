DATABASE_URL="file:./dev.db"

NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Super-admin access (server-side only; comma-separated emails)
SUPER_ADMIN_EMAILS="superadmin@yourdomain.com"

# Separate pepper for privacy-preserving audit IP hashes. Do not expose publicly.
AUDIT_HASH_PEPPER="generate-a-separate-random-pepper-here"

# Internal scheduled processors. Send Authorization: Bearer <CRON_SECRET>.
CRON_SECRET="generate-a-separate-random-secret-here"
# For the GitHub Actions email-outbox workflow, configure repository secrets:
# OUTBOX_PROCESSOR_URL=https://your-production-domain.example
# CRON_SECRET=<same value as the production environment>

# Stripe Checkout for network credit packs
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Every pack must match an existing Stripe Price exactly. amountCents and currency
# are independently reconciled against Checkout Session payment data before credits are added.
STRIPE_CREDIT_PACKS_JSON='[{"id":"starter","label":"Starter pack","credits":25,"priceId":"price_...","amountCents":4900,"currency":"CAD","description":"25 lead-network contact unlock credits"},{"id":"growth","label":"Growth pack","credits":75,"priceId":"price_...","amountCents":12900,"currency":"CAD","description":"75 lead-network contact unlock credits"}]'

# Meta (Facebook + Instagram Lead Ads)
# Get these from https://developers.facebook.com/apps/
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN="choose-any-random-string"

# Google Local Services Ads
# Get from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email SMTP. Standard outbound emails are persisted in EmailOutbox and retried
# through /api/internal/email-outbox/process when SMTP is unavailable or transiently fails.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="yourname@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="HandymanPro <yourname@gmail.com>"

# Mailgun - for receiving leads from HomeStars/Kijiji via email
# Get from https://app.mailgun.com/
MAILGUN_WEBHOOK_SIGNING_KEY=""
