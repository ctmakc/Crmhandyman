### Required — the app refuses to start in the container without these ###

# SQLite file. In the container it MUST live on the mounted volume (/app/var/…),
# otherwise the database dies with the container. docker-entrypoint.sh enforces it.
DATABASE_URL="file:./dev.db"

# Signing key for sessions. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-random-secret-here"

# The app's own public origin. Used for sign-in callbacks AND as the address the
# middleware calls itself on to resolve a workspace's plan — that call used to be aimed
# at the request's Host header, which handed the secret to whoever set the header.
# Unset or malformed, no workspace resolves and every request lands on /register.
NEXTAUTH_URL="http://localhost:3000"


### Access and limits ###

# Super admin panel access. BOTH are required — an operator is an email on this list
# whose account lives in the platform's own workspace and is an admin there. Leaving
# PLATFORM_TENANT_SLUG empty disables the panel outright rather than opening it.
SUPER_ADMIN_EMAILS="superadmin@yourdomain.com"
PLATFORM_TENANT_SLUG=""

# Self-serve signup at /register. Unset means OFF in production and on in development:
# a CRM on a real domain with an open form collects strangers' workspaces on the
# contractor's host. Set to "on" only if you actually want public trials.
SELF_SERVE_SIGNUP=""

# Trial length in days for a self-service signup.
TRIAL_DAYS="7"

# How many proxies stand in front of the app. The throttles read the client address
# from X-Forwarded-For counting from the RIGHT, because the left of that header is
# whatever the caller typed — reading it hands an attacker unlimited fresh identities
# and the login limiter stops existing. One = the single Caddy in DEPLOY.md. Raise it
# only if you add another hop (a CDN), and never point the app straight at the internet
# while it is set above zero.
TRUSTED_PROXY_HOPS="1"

# A repeat enquiry from the same address inside this window is treated as the same lead.
# Shared by the mail hook and by landing-page intake.
LEAD_DEDUP_DAYS="30"

# Shown on the trial banner's «Upgrade» button. Compiled into the browser bundle, so
# changing it needs a rebuild, not just a restart.
NEXT_PUBLIC_SUPPORT_EMAIL="support@yourdomain.com"


### Job photos ###

# Where uploaded photos land. Outside public/ on purpose — every read goes through
# /api/photos/[id], which checks the session first. In the container this must sit on
# the volume (/app/var/uploads) or the photos vanish on the next deploy.
UPLOADS_DIR="var/uploads"
# Per-photo size cap in megabytes; a malformed value falls back to 12.
MAX_UPLOAD_MB="12"
# How many photos one job may hold; a malformed value falls back to 40.
MAX_PHOTOS_PER_JOB="40"


### Integrations — every one is fail-closed when left empty ###

# Meta (Facebook + Instagram Lead Ads). Without META_APP_SECRET the webhook cannot
# verify a signature and rejects every delivery instead of trusting it.
# Get these from https://developers.facebook.com/apps/
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN="choose-any-random-string"

# Google Local Services Ads. Empty means the channel simply stays unconnected.
# Get from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email SMTP (Gmail example). Empty means overdue reminders are recorded as attempted
# and reported as unsent — the desk shows the truth rather than pretending.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="yourname@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="HandymanPro <yourname@gmail.com>"

# Mailgun — for receiving leads from HomeStars/Kijiji via email. Empty means the
# webhook accepts nothing at all; it used to accept anything from anyone.
# Get from https://app.mailgun.com/
MAILGUN_WEBHOOK_SIGNING_KEY=""


### Container operation — read by docker-compose.yml and the backup scripts ###

# Host port the container is published on, bound to 127.0.0.1.
APP_PORT="3000"
# How many nightly database snapshots to keep in var/backups. Unset falls back to 14.
BACKUP_KEEP="14"
