generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Tenant {
  id                String               @id @default(cuid())
  slug              String               @unique
  businessName      String
  ownerEmail        String
  plan              TenantPlan           @default(DEMO)
  expiresAt         DateTime?
  createdAt         DateTime             @default(now())
  users             User[]
  leads             Lead[]
  projects          Project[]
  tasks             Task[]
  payments          Payment[]
  expenses          Expense[]
  integrations      ChannelIntegration[]
  contractorProfile ContractorProfile?
  marketplaceJobs   MarketplaceJob[]     @relation("MarketplaceJobSourceTenant")
  leadListings      LeadListing[]
  claimedLeads      LeadClaim[]          @relation("ClaimedByTenant")
}

enum TenantPlan {
  DEMO
  PAID
}

model User {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  email         String
  password      String
  role          Role     @default(WORKER)
  assignedLeads Lead[]
  assignedTasks Task[]   @relation("assignedTasks")
  createdTasks  Task[]   @relation("createdTasks")
  createdAt     DateTime @default(now())

  @@unique([email, tenantId])
}

enum Role {
  ADMIN
  WORKER
}

model Lead {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  name           String
  phone          String?
  email          String?
  address        String?
  city           String?
  source         LeadSource      @default(MANUAL)
  sourceLeadId   String?
  jobType        String?
  notes          String?
  status         LeadStatus      @default(NEW)
  assignedTo     User?           @relation(fields: [assignedToId], references: [id])
  assignedToId   String?
  project        Project?
  marketplaceJob MarketplaceJob? @relation("MarketplaceJobConvertedLead")
  leadListing    LeadListing?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

enum LeadSource {
  FACEBOOK
  INSTAGRAM
  GOOGLE
  HOMESTARS
  KIJIJI
  EMAIL
  MANUAL
  MARKETPLACE
  DIRECTORY
  REFERRAL
  LEAD_EXCHANGE
  SUBCONTRACT
  JOB_BOARD
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  VERIFIED
  REJECTED
  CONVERTED
}

model Project {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  lead          Lead?         @relation(fields: [leadId], references: [id])
  leadId        String?       @unique
  clientName    String
  phone         String?
  email         String?
  address       String
  title         String
  description   String?
  jobType       String?
  status        ProjectStatus @default(SCHEDULED)
  scheduledDate DateTime?
  completedDate DateTime?
  assignedToId  String?
  estimates     Estimate[]
  tasks         Task[]
  payments      Payment[]
  expenses      Expense[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum ProjectStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Estimate {
  id         String         @id @default(cuid())
  project    Project        @relation(fields: [projectId], references: [id])
  projectId  String
  lineItems  String
  subtotal   Float
  tax        Float
  total      Float
  notes      String?
  validUntil DateTime?
  status     EstimateStatus @default(DRAFT)
  pdfUrl     String?
  createdAt  DateTime       @default(now())
}

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

model Task {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  project      Project?   @relation(fields: [projectId], references: [id])
  projectId    String?
  title        String
  description  String?
  assignedTo   User       @relation("assignedTasks", fields: [assignedToId], references: [id])
  assignedToId String
  createdBy    User       @relation("createdTasks", fields: [createdById], references: [id])
  createdById  String
  dueDate      DateTime?
  status       TaskStatus @default(TODO)
  createdAt    DateTime   @default(now())
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Payment {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  project   Project       @relation(fields: [projectId], references: [id])
  projectId String
  amount    Float
  method    PaymentMethod @default(CASH)
  date      DateTime      @default(now())
  notes     String?
}

enum PaymentMethod {
  CASH
  E_TRANSFER
  CHEQUE
  CARD
}

model Expense {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  project     Project?        @relation(fields: [projectId], references: [id])
  projectId   String?
  amount      Float
  category    ExpenseCategory
  description String?
  date        DateTime        @default(now())
  receiptUrl  String?
}

enum ExpenseCategory {
  MATERIALS
  LABOR
  TOOLS
  VEHICLE
  OTHER
}

model ChannelIntegration {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  channel       String
  accessToken   String?
  pageId        String?
  webhookSecret String?
  config        String?
  isActive      Boolean  @default(false)
  lastSyncAt    DateTime?

  @@unique([tenantId, channel])
}

model ContractorProfile {
  id                  String             @id @default(cuid())
  tenantId            String             @unique
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug                String             @unique
  displayName         String
  headline            String?
  description         String?
  logoUrl             String?
  coverUrl            String?
  phone               String?
  publicEmail         String?
  website             String?
  address             String?
  city                String
  province            String
  postalCode          String?
  country             String             @default("Canada")
  latitude            Float?
  longitude           Float?
  serviceRadiusKm     Int                @default(30)
  yearsInBusiness     Int?
  emergencyService    Boolean            @default(false)
  minimumJobValue     Float?
  languages           String             @default("English")
  insuranceVerified   Boolean            @default(false)
  licenceVerified     Boolean            @default(false)
  identityVerified    Boolean            @default(false)
  verificationStatus  VerificationStatus @default(UNVERIFIED)
  profileStatus       ProfileStatus      @default(DRAFT)
  averageRating       Float              @default(0)
  reviewCount         Int                @default(0)
  responseTimeMinutes Int?
  completedJobs       Int                @default(0)
  seoTitle            String?
  seoDescription      String?
  services            ContractorService[]
  serviceAreas        ServiceArea[]
  reviews             Review[]
  portfolio           PortfolioItem[]
  vacancies           Vacancy[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([city, province])
  @@index([profileStatus, verificationStatus])
}

model ContractorService {
  id          String            @id @default(cuid())
  profileId   String
  profile     ContractorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  category    String
  description String?
  priceFrom   Float?
  isPrimary   Boolean           @default(false)
  createdAt   DateTime          @default(now())

  @@unique([profileId, slug])
  @@index([slug, category])
}

model ServiceArea {
  id           String            @id @default(cuid())
  profileId    String
  profile      ContractorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  city         String
  province     String
  country      String            @default("Canada")
  postalPrefix String?
  latitude     Float?
  longitude    Float?
  radiusKm     Int               @default(30)
  createdAt    DateTime          @default(now())

  @@index([city, province])
  @@index([postalPrefix])
}

model Review {
  id         String            @id @default(cuid())
  profileId  String
  profile    ContractorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  authorName String
  rating     Int
  title      String?
  body       String
  source     ReviewSource      @default(UNVERIFIED)
  sourceUrl  String?
  isVisible  Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([profileId, isVisible])
}

model PortfolioItem {
  id          String            @id @default(cuid())
  profileId   String
  profile     ContractorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  description String?
  imageUrl    String
  city        String?
  serviceSlug String?
  completedAt DateTime?
  isPublished Boolean           @default(true)
  createdAt   DateTime          @default(now())

  @@index([profileId, isPublished])
}

model MarketplaceJob {
  id              String               @id @default(cuid())
  slug            String               @unique
  customerName    String
  customerEmail   String
  customerPhone   String?
  title           String
  description     String
  serviceSlug     String
  city            String
  province        String
  postalCode      String?
  address         String?
  latitude        Float?
  longitude       Float?
  budgetMin       Float?
  budgetMax       Float?
  urgency         JobUrgency           @default(FLEXIBLE)
  status          MarketplaceJobStatus @default(OPEN)
  consentToShare  Boolean              @default(false)
  sourceTenantId  String?
  sourceTenant    Tenant?              @relation("MarketplaceJobSourceTenant", fields: [sourceTenantId], references: [id], onDelete: SetNull)
  convertedLeadId String?              @unique
  convertedLead   Lead?                @relation("MarketplaceJobConvertedLead", fields: [convertedLeadId], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([serviceSlug, city, province, status])
  @@index([createdAt])
}

model Vacancy {
  id               String            @id @default(cuid())
  profileId        String
  profile          ContractorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  slug             String            @unique
  title            String
  description      String
  serviceSlug      String
  employmentType   EmploymentType
  city             String
  province         String
  compensationMin  Float?
  compensationMax  Float?
  compensationUnit CompensationUnit   @default(HOUR)
  isRemote         Boolean            @default(false)
  status           VacancyStatus      @default(DRAFT)
  validThrough     DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([serviceSlug, city, province, status])
}

model LeadListing {
  id                        String            @id @default(cuid())
  tenantId                  String
  tenant                    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId                    String            @unique
  lead                      Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title                     String
  summary                   String
  serviceSlug               String
  city                      String
  province                  String
  budgetMin                 Float?
  budgetMax                 Float?
  status                    LeadListingStatus @default(OPEN)
  maxClaims                 Int               @default(3)
  exclusive                 Boolean           @default(false)
  contactUnlockPriceCredits Int               @default(1)
  expiresAt                 DateTime?
  claims                    LeadClaim[]
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  @@index([serviceSlug, city, province, status])
}

model LeadClaim {
  id          String          @id @default(cuid())
  listingId   String
  listing     LeadListing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tenantId    String
  claimedBy   Tenant          @relation("ClaimedByTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  status      LeadClaimStatus @default(REQUESTED)
  creditsPaid Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([listingId, tenantId])
  @@index([tenantId, status])
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  SUSPENDED
}

enum ProfileStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  SUSPENDED
}

enum ReviewSource {
  VERIFIED_PROJECT
  VERIFIED_CUSTOMER
  IMPORTED
  UNVERIFIED
}

enum JobUrgency {
  EMERGENCY
  WITHIN_48_HOURS
  THIS_WEEK
  FLEXIBLE
}

enum MarketplaceJobStatus {
  OPEN
  MATCHING
  ASSIGNED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  GIG
  SUBCONTRACT
}

enum CompensationUnit {
  HOUR
  DAY
  PROJECT
  YEAR
}

enum VacancyStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
  EXPIRED
}

enum LeadListingStatus {
  OPEN
  MATCHED
  CLOSED
  EXPIRED
  DISPUTED
}

enum LeadClaimStatus {
  REQUESTED
  APPROVED
  REJECTED
  CONTACT_UNLOCKED
  WON
  LOST
  REFUNDED
}
