# HandyCRM production environment for the hostd/Cloudflare deployment.
# Copy to deploy/hostd/.env on the production box and chmod 600.
# Never commit the filled file.

### Required application identity ###

# Generate once with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Platform front door. Customer workspaces are siblings: <slug>.itopsi.com.
NEXTAUTH_URL="https://crm.itopsi.com"
CRM_HOME_HOST="crm.itopsi.com"
NEXTAUTH_COOKIE_DOMAIN=".itopsi.com"

# Cloudflare edge is the one trusted X-Forwarded-For appender in the documented tunnel path.
TRUSTED_PROXY_HOPS="1"
APP_PORT="3080"

### Access ###

# Keep public signup closed unless deliberately running a trial campaign.
SELF_SERVE_SIGNUP=""
TRIAL_DAYS="7"

# Optional platform super-admin workspace. Empty slug disables /admin.
SUPER_ADMIN_EMAILS=""
PLATFORM_TENANT_SLUG=""

### Google auth ###

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_AUTH_ORIGIN="https://crm.itopsi.com"

### Meta lead ads ###

META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""

### Email ###

MAILGUN_WEBHOOK_SIGNING_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

### Lead automation ###

# Generate separately from NEXTAUTH_SECRET, e.g. openssl rand -hex 32.
# The exact same value must be stored as the GitHub Actions repository secret
# AUTOMATION_CRON_SECRET. The scheduler URL secret should be:
# AUTOMATION_PROCESSOR_URL=https://crm.itopsi.com
# Leaving this blank keeps /api/webhooks/lead-automation fail-closed.
AUTOMATION_CRON_SECRET=""

### Data / operating limits ###

LEAD_DEDUP_DAYS="30"
MAX_UPLOAD_MB="12"
MAX_PHOTOS_PER_JOB="40"
BACKUP_KEEP="14"
NEXT_PUBLIC_SUPPORT_EMAIL="support@itopsi.com"

### Optional demo ###

NEXT_PUBLIC_DEMO_SLUG="try"
NEXT_PUBLIC_DEMO_EMAIL=""
NEXT_PUBLIC_DEMO_PASSWORD=""

### Host health / backup alerts ###

ALERT_TELEGRAM_BOT_TOKEN=""
ALERT_TELEGRAM_CHAT_ID=""
ALERT_MIN_INTERVAL_MIN="60"

# Public routing is NOT stored here because this deployment uses a locally managed
# cloudflared config mounted from /opt/handyman-crm/cloudflared. That config must route:
#   crm.itopsi.com  -> http://crm:3000
#   *.itopsi.com    -> http://crm:3000
# and the itopsi.com DNS zone must point those hostnames at the tunnel.
