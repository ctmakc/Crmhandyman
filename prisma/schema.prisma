generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Tenant {
  id           String      @id @default(cuid())
  slug         String      @unique
  businessName String
  ownerEmail   String
  plan         TenantPlan  @default(DEMO)
  expiresAt    DateTime?
  createdAt    DateTime    @default(now())
  users        User[]
  clients      Client[]
  equipment    Equipment[]
  contracts    ServiceContract[]
  leads        Lead[]
  projects     Project[]
  tasks        Task[]
  invoices     Invoice[]
  payments     Payment[]
  expenses     Expense[]
  integrations ChannelIntegration[]
}

enum TenantPlan {
  DEMO
  PAID
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  name         String
  email        String
  password     String
  role         Role      @default(WORKER)
  assignedLeads Lead[]
  assignedProjects Project[] @relation("assignedProjects")
  assignedTasks Task[]   @relation("assignedTasks")
  createdTasks  Task[]   @relation("createdTasks")
  createdAt    DateTime  @default(now())

  @@unique([email, tenantId])
}

enum Role {
  ADMIN
  WORKER
}

/// The customer, not the string on a work order. One roof, one furnace history,
/// one balance owing — jobs and leads point at this, they no longer re-type it.
model Client {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  name      String
  phone     String?
  email     String?
  address   String?
  city      String?
  notes     String?
  leads     Lead[]
  projects  Project[]
  equipment Equipment[]
  contracts ServiceContract[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([tenantId, name])
}

/// What is actually installed at the address. HVAC lives on iron, not on tickets:
/// the serial number and the warranty date are what a tech needs before the visit.
model Equipment {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  client        Client        @relation(fields: [clientId], references: [id])
  clientId      String
  project       Project?      @relation(fields: [projectId], references: [id])
  projectId     String?
  kind          EquipmentKind @default(FURNACE)
  brand         String?
  model         String?
  serial        String?
  location      String?
  installedAt   DateTime?
  warrantyUntil DateTime?
  notes         String?
  contracts     ServiceContract[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([tenantId, clientId])
}

/// Recurring maintenance — the recurring revenue an HVAC shop actually lives on.
/// `visitMonths` is a JSON array of 1-12 (e.g. [4,10] = spring and fall), which keeps
/// the schedule readable in the database and avoids a cron owning the truth.
model ServiceContract {
  id            String     @id @default(cuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  client        Client     @relation(fields: [clientId], references: [id])
  clientId      String
  equipment     Equipment? @relation(fields: [equipmentId], references: [id])
  equipmentId   String?
  name          String
  visitMonths   String
  pricePerVisit Float
  autoInvoice   Boolean    @default(false)
  active        Boolean    @default(true)
  startedOn     DateTime   @default(now())
  notes         String?
  projects      Project[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([tenantId, active])
}

enum EquipmentKind {
  FURNACE
  AC
  HEAT_PUMP
  WATER_HEATER
  BOILER
  THERMOSTAT
  DUCTWORK
  OTHER
}

model Lead {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  name         String
  phone        String?
  email        String?
  address      String?
  city         String?
  source       LeadSource @default(MANUAL)
  sourceLeadId String?
  jobType      String?
  notes        String?
  status       LeadStatus @default(NEW)
  client       Client?    @relation(fields: [clientId], references: [id])
  clientId     String?
  assignedTo   User?      @relation(fields: [assignedToId], references: [id])
  assignedToId String?
  project      Project?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum LeadSource {
  FACEBOOK
  INSTAGRAM
  GOOGLE
  HOMESTARS
  KIJIJI
  EMAIL
  MANUAL
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  VERIFIED
  REJECTED
  CONVERTED
}

model Project {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  lead          Lead?         @relation(fields: [leadId], references: [id])
  leadId        String?       @unique
  client        Client?       @relation(fields: [clientId], references: [id])
  clientId      String?
  contract      ServiceContract? @relation(fields: [contractId], references: [id])
  contractId    String?
  /// Which month of the contract year this visit covers — stops the scheduler
  /// booking the same seasonal visit twice.
  contractCycle String?
  clientName    String
  phone         String?
  email         String?
  address       String
  title         String
  description   String?
  jobType       String?
  status        ProjectStatus @default(SCHEDULED)
  scheduledDate DateTime?
  completedDate DateTime?
  assignedTo    User?         @relation("assignedProjects", fields: [assignedToId], references: [id])
  assignedToId  String?
  estimates     Estimate[]
  tasks         Task[]
  equipment     Equipment[]
  invoices      Invoice[]
  payments      Payment[]
  expenses      Expense[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum ProjectStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Estimate {
  id         String         @id @default(cuid())
  project    Project        @relation(fields: [projectId], references: [id])
  projectId  String
  lineItems  String
  subtotal   Float
  tax        Float
  total      Float
  notes      String?
  validUntil DateTime?
  status     EstimateStatus @default(DRAFT)
  pdfUrl     String?
  createdAt  DateTime       @default(now())
}

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

model Task {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  project      Project?   @relation(fields: [projectId], references: [id])
  projectId    String?
  title        String
  description  String?
  assignedTo   User       @relation("assignedTasks", fields: [assignedToId], references: [id])
  assignedToId String
  createdBy    User       @relation("createdTasks", fields: [createdById], references: [id])
  createdById  String
  dueDate      DateTime?
  status       TaskStatus @default(TODO)
  createdAt    DateTime   @default(now())
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Invoice {
  id         String        @id @default(cuid())
  /// A deposit and its balance are two invoices cut from one estimate — that is how
  /// a shop bills an install, and it keeps each half independently payable.
  kind       InvoiceKind   @default(FULL)
  remindedAt DateTime?
  reminderCount Int        @default(0)
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  project    Project       @relation(fields: [projectId], references: [id])
  projectId  String
  estimateId String?
  number     String
  clientName String
  address    String?
  email      String?
  lineItems  String
  subtotal   Float
  tax        Float
  total      Float
  notes      String?
  status     InvoiceStatus @default(DRAFT)
  issuedAt   DateTime      @default(now())
  dueDate    DateTime?
  sentAt     DateTime?
  paidAt     DateTime?
  payments   Payment[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([tenantId, number])
}

enum InvoiceKind {
  FULL
  DEPOSIT
  BALANCE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  VOID
}

model Payment {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  project   Project       @relation(fields: [projectId], references: [id])
  projectId String
  invoice   Invoice?      @relation(fields: [invoiceId], references: [id])
  invoiceId String?
  amount    Float
  method    PaymentMethod @default(CASH)
  date      DateTime      @default(now())
  notes     String?
}

enum PaymentMethod {
  CASH
  E_TRANSFER
  CHEQUE
  CARD
}

model Expense {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  project     Project?        @relation(fields: [projectId], references: [id])
  projectId   String?
  amount      Float
  category    ExpenseCategory
  description String?
  date        DateTime        @default(now())
  receiptUrl  String?
}

enum ExpenseCategory {
  MATERIALS
  LABOR
  TOOLS
  VEHICLE
  OTHER
}

model ChannelIntegration {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  channel       String
  accessToken   String?
  pageId        String?
  webhookSecret String?
  config        String?
  isActive      Boolean  @default(false)
  lastSyncAt    DateTime?

  @@unique([tenantId, channel])
}
